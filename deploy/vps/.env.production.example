# Copy to .env.production on the VPS; never commit the populated file.
SITE_DOMAIN=giovsoft.com
ACME_EMAIL=hola@giovsoft.com
PREVIEW_PORT=8080
ADMIN_EMAIL=hola@giovsoft.com
ADMIN_NAME=GiovSoft
ADMIN_2FA_ENABLED=true
# Unique random values are required. init-env.py creates them without printing them.
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
# SMTP is needed for admin two-factor login and email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
